# Jellyfin.Server is rebuilt from this commit and its jellyfin.dll replaces the base image's
# (see .github/workflows/build.yaml). The commit must be the base image's Jellyfin release
# plus fixes; the build checks that its version matches the FROM tag in the Dockerfile.
#
# a2a4042408: v12.4 + "Materialise ratings before updating them in MigrateRatingLevels",
# without which 12.4's MigrateRatingLevels fails on PostgreSQL. Remove this file and the
# patch steps once a Jellyfin release includes the fix.
JELLYFIN_PATCH_REPO=evan314159/jellyfin
JELLYFIN_PATCH_REF=a2a4042408c52a1f02aec13babc2b8c8b165e0b2
